{
  "name": "@byted-postgresql/cli",
  "version": "0.0.0",
  "description": "Volcengine PostgreSQL CLI for managing PostgreSQL workspaces, branches, computes, databases, and endpoints.",
  "repository": {
    "type": "git",
    "url": "https://github.com/volcengine/byted-postgresql-cli.git"
  },
  "homepage": "https://github.com/volcengine/byted-postgresql-cli",
  "bugs": {
    "url": "https://github.com/volcengine/byted-postgresql-cli/issues"
  },
  "license": "MIT",
  "author": "Volcengine",
  "type": "module",
  "engines": {
    "npm": ">=8"
  },
  "files": [
    "bin/cli.js",
    "bin/install.js",
    "bin/paths.js",
    "skills/"
  ],
  "scripts": {
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "test:npm": "node --test scripts/install.test.mjs"
  },
  "bin": {
    "byted-postgresql-cli": "bin/cli.js"
  },
  "optionalDependencies": {
    "@byted-postgresql/cli-darwin-x64": "0.0.0",
    "@byted-postgresql/cli-darwin-arm64": "0.0.0",
    "@byted-postgresql/cli-linux-x64": "0.0.0",
    "@byted-postgresql/cli-linux-arm64": "0.0.0",
    "@byted-postgresql/cli-win32-x64": "0.0.0",
    "@byted-postgresql/cli-win32-arm64": "0.0.0"
  }
}
